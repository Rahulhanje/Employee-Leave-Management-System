    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Manager",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.environment.set('manager_jwt_token', jsonData.data.token);",
                  "    pm.collectionVariables.set('manager_jwt_token', jsonData.data.token);",
                  "    console.log('Manager token saved:', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Manager\",\n  \"email\": \"jane.manager@test.com\",\n  \"password\": \"Manager123\",\n  \"role\": \"manager\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Register a new manager account. Token is automatically saved."
          },
          "response": []
        },
