    {
      "name": "Employee - Create Test Leaves",
      "item": [
        {
          "name": "Apply Sick Leave",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('leave_id', jsonData.data.leaveRequest.id);",
                  "    console.log('Leave ID saved:', jsonData.data.leaveRequest.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{employee_jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leaveType\": \"sick\",\n  \"startDate\": \"2025-12-01\",\n  \"endDate\": \"2025-12-03\",\n  \"reason\": \"Medical appointment and recovery needed for health checkup\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/leaves",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "leaves"
              ]
            },
            "description": "Employee applies for sick leave. Leave ID is saved for manager approval."
          },
          "response": []
        },
